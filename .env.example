# Phoenix Web Application Environment Configuration
# Copy this file to .env and fill in your actual values

# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_CONFIG=development

# Firebase Configuration (Optional - leave empty to use mock database)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id

# Alternative: Use Google Application Default Credentials
# Set this to the path of your service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json

# Database Configuration (if using SQLite instead of Firebase)
# DATABASE_URL=sqlite:///phoenix.db

# Email Configuration (for notifications)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# File Upload Configuration
# MAX_CONTENT_LENGTH=16777216  # 16MB in bytes
# UPLOAD_FOLDER=uploads
